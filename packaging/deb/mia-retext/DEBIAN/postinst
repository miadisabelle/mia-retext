#!/bin/sh
# ReText gets its own venv, built only from the wheels in this package (--no-index):
# nothing from PyPI, /usr/local or a user's conda, and not the distribution's
# python3-markups or PyQt (Ubuntu 22.04 has Markups 3 and no PyQt6). The wheels
# cover CPython 3.10 to 3.14; python3 is the interpreter used. A package
# installing /usr/bin/python3 (a release upgrade) triggers a rebuild.
set -e
# Every user runs ReText from this venv, whatever root's umask is.
umask 022
venv=/usr/lib/mia-retext/venv
wheels=/usr/share/mia-retext/wheels
case "$1" in
configure|triggered)
	tag=$(python3 -c 'import sys; print("cp%d%d" % sys.version_info[:2])')
	if ! ls "$wheels"/[Pp]y[Qq]t6_sip-*-"$tag"-*.whl >/dev/null 2>&1; then
		echo "mia-retext: no wheels for $(python3 -V 2>&1) ($tag) in $wheels" >&2
		exit 1
	fi
	rm -rf "$venv"
	python3 -m venv "$venv"
	PIP_DISABLE_PIP_VERSION_CHECK=1 "$venv/bin/pip" install -q --no-cache-dir --no-index \
		--find-links "$wheels" -r "$wheels/requirements.txt"
	"$venv/bin/python3" -c 'import ReText.window, markups, markdown, docutils, pygments'
	echo "mia-retext: $("$venv/bin/python3" -c 'import ReText, PyQt6.QtCore as Q; print("ReText", ReText.app_version, "PyQt", Q.PYQT_VERSION_STR, "Qt", Q.QT_VERSION_STR)') in $venv ($(python3 -V 2>&1))" >&2
	;;
esac
exit 0
